[Unit]
Description=Purge expired Ubuntu Deep Cleaner quarantine entries

[Service]
Type=oneshot
User=root
Group=root
Environment=UDC_STATE_DIR=/var/lib/ubuntu-deep-cleaner
ExecStart=/usr/bin/node /opt/ubuntu-deep-cleaner/current/dist/agent/purge.js
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
